// Program 4: This program converts a given distance in millimeters to centimeters, inches, and feet.
#include <stdio.h>

int main() {
    float mm, cm, inch, feet;

    printf("Enter distance in mm: ");
    scanf("%f", &mm);

    cm = mm / 10.0;        // 1 cm = 10 mm
    inch = cm / 2.5;       // 1 inch = 2.5 cm
    feet = inch / 12.0;    // 1 feet = 12 inches

    printf("%.2f mm = %.2f cm\n", mm, cm);
    printf("%.2f mm = %.2f inch\n", mm, inch);
    printf("%.2f mm = %.2f feet\n", mm, feet);

    printf("Program 4 done\n");

    return 0;
}