// Program 5: This program calculates the distance between two points in a 2D plane.
#include <stdio.h>
#include <math.h>

int main() {
    float x1, y1, x2, y2, distance;

    printf("Enter x1 and y1: ");
    scanf("%f %f", &x1, &y1);

    printf("Enter x2 and y2: ");
    scanf("%f %f", &x2, &y2);

    distance = sqrt(pow((x2 - x1), 2) + pow((y2 - y1), 2));

    printf("Distance between (%.2f, %.2f) and (%.2f, %.2f) = %.2f\n", x1, y1, x2, y2, distance);

    printf("Program 5 done\n");

    return 0;
}