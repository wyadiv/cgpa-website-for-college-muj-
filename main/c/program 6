// Program 6: This program calculates the area of a circle given its radius.
#include <stdio.h>

int main() {
    float radius, area;
    const float PI = 3.14159;

    printf("Enter the radius of the circle: ");
    scanf("%f", &radius);

    area = PI * radius * radius;

    printf("Area of circle with radius %.2f = %.2f\n", radius, area);

    printf("Program 6 done\n");

    return 0;
}